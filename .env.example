# Copy to .env.local for local dev; add the same keys in Vercel → Settings → Environment Variables
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/pakdharti
# AI: Google Gemini free tier by default (key from aistudio.google.com)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: override the model, e.g. a Flash-Lite model for higher free limits
AI_MODEL=
# To use Claude instead: AI_PROVIDER=anthropic, ANTHROPIC_API_KEY=..., AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Images: Unsplash (or PEXELS_API_KEY if you have one)
UNSPLASH_ACCESS_KEY=

# Admin panel login (/admin)
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=long-random-string-1
# For scripts calling /api/admin/* directly
ADMIN_API_KEY=long-random-string-2
# For cron-job.org calling /api/cron/*
CRON_SECRET=long-random-string-3

AUTO_PUBLISH=false
